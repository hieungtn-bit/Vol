# ---- Nguồn dữ liệu (không bắt buộc, đều có mặc định) ----
# Spot klines + ticker 24h. data-api.binance.vision không cần key, không bị rate-limit gắt.
BINANCE_SPOT_BASE=https://data-api.binance.vision
BINANCE_SPOT_FALLBACK=https://api.binance.com

# USDT-M perp. Thường trả 451/403 từ VPS US/EU -> hệ tự tắt taker perp và rơi sang OKX.
BINANCE_FAPI_BASE=https://fapi.binance.com

# OKX public (funding, mark, open interest). Không cần key.
OKX_BASE=https://www.okx.com

# ---- Tuỳ chọn ----
# CoinGlass chỉ dùng khi bạn TỰ dán key. Không có key -> OI vẫn lấy từ Binance/OKX public.
COINGLASS_API_KEY=

# TTL cache cho response exchange, milliseconds (15000-30000 là hợp lý).
CACHE_TTL_MS=20000

# Thư mục lưu snapshot scan (JSON). Để trống = tắt lưu snapshot.
SNAPSHOT_DIR=./data/snapshots
